# systemd 服务读的环境变量文件示例，放到 /etc/game-design-library/mcp.env。
# 每个变量的完整说明见 mcp/.env.example。这里没有任何密钥。

# 数据来源：跟随已部署的网站（把地址换成网站的实际地址；网站在子路径下时带上子路径）
GDL_SITE_URL=https://example.com

# 想固定在某个发布编号上时取消注释
# GDL_RELEASE_ID=2026-11-13.2

# 或者改用本地目录（此时去掉上面的 GDL_SITE_URL）
# GDL_RELEASE_DIR=/var/www/game-design-library/data/release/2026-11-13.2

GDL_HTTP_HOST=127.0.0.1
GDL_HTTP_PORT=8787

# 允许直接调用的浏览器来源，逗号分隔；留空表示不允许任何网页直接调用（命令行工具和 AI 服务的服务器不受影响）
GDL_ALLOWED_ORIGINS=

GDL_REFRESH_SECONDS=300
GDL_CACHE_DIR=/var/cache/gdl-mcp
GDL_ACCESS_LOG=0
