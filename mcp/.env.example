# 猫叔的游戏知识库 MCP 服务（HTTP 入口）的环境变量示例。
# 复制成 .env 后按实际情况修改。这里没有任何密钥：服务只读、无登录。

# ---- 数据来源：三种任选一种（同时写了多个时，按 目录 > 发布包网址 > 网站地址 的顺序取第一个）----

# 方式一：跟随已部署的网站（推荐）。读 <网站地址>/data/current.json 得到当前发布编号，
# 之后每隔 GDL_REFRESH_SECONDS 秒再看一次，网站换了发布包这里自动跟着换，不用重启。
GDL_SITE_URL=https://example.com

# 和 GDL_SITE_URL 一起用：固定用某个发布编号，不跟随 current.json。
# GDL_RELEASE_ID=2026-11-13.1

# 方式二：直接给某个发布包的网址前缀（该地址下能取到 manifest.json）。
# GDL_RELEASE_URL=https://example.com/data/release/2026-11-13.1

# 方式三：本地目录（里面有 manifest.json）。不联网。
# GDL_RELEASE_DIR=/srv/game-design-library/site/data/release/2026-11-13.1

# ---- 监听 ----

# 监听地址。默认 127.0.0.1（只有本机能连，由同一台机器上的反向代理转发）。
# 在容器里要设成 0.0.0.0（docker-compose.yml 已经设了）。
GDL_HTTP_HOST=127.0.0.1
GDL_HTTP_PORT=8787

# ---- 访问控制 ----

# 允许的浏览器来源（Origin 请求头），逗号分隔，例如 https://example.com,https://tools.example.com；
# 写 * 表示全部允许。留空表示不允许任何浏览器页面直接调用。
# 不带 Origin 的请求（Claude Code 等命令行工具、各家 AI 服务的服务器）不受这一项影响，总是放行。
GDL_ALLOWED_ORIGINS=

# 允许的 Host 请求头，逗号分隔，例如 mcp.example.com。留空表示不检查。
# 设了以后，反向代理必须把原始 Host 传过来（Nginx 的 proxy_set_header Host $host）。
GDL_ALLOWED_HOSTS=

# ---- 其他 ----

# 跟随网站时每隔多少秒检查一次 current.json。默认 300；0 表示只在启动时读一次。
GDL_REFRESH_SECONDS=300

# 网址来源的缓存目录。不设时用运行用户的缓存目录（Linux 是 ~/.cache/game-design-library-mcp）。
# GDL_CACHE_DIR=/var/cache/game-design-library-mcp

# 设为 1 时每个请求记一行日志：方法、路径、状态码、耗时。不记请求内容和来源地址。
GDL_ACCESS_LOG=0
